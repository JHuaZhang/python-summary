{
  "compilerOptions": {
    "target": "ES2017",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "baseUrl": "./",
    "lib": ["es2017", "dom"],
    "skipLibCheck": true,
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "noImplicitAny": false,
    "resolveJsonModule": true,
    "strict": false,
    "jsx": "react-jsx",
    "types": ["@types/node"]
  },
  "include": ["rspress.config.ts", "scripts/**/*", "theme/**/*"],
  "exclude": [
    "node_modules",
    "dist"
  ]
}